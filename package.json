{
  "name": "mini-notes-with-llm-summary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "setup:python": "uv venv .venv --python 3.12 --no-python-downloads",
    "sync:python": "uv sync --no-python-downloads",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "validate": "anna-app validate --strict",
    "anna:dev": "node scripts/anna-dev.mjs",
    "executa:dev": "node scripts/anna-executa-dev.mjs",
    "test": "pnpm test:unit && pnpm test:executa && pnpm test:versions && pnpm test:harness && pnpm test:browser",
    "test:unit": "vitest run",
    "test:executa": "node scripts/run-python.mjs -m unittest discover -s tests -p \"test_executa*.py\"",
    "test:versions": "node scripts/run-python.mjs scripts/prepare_release.py --check",
    "test:harness": "pnpm build && node scripts/run-python.mjs -m unittest discover -s tests -p \"test_harness.py\"",
    "test:browser": "pnpm build && playwright test",
    "build:binary": "node scripts/run-python.mjs scripts/build_binary.py"
  },
  "dependencies": {
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@anna-ai/cli": "0.1.63",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
